module decoder_7_seg_on_board(
	input [1:0] SW,
	output [6:0] HEX0); // sprawdzić z "output [0:6] HEX0"

	decoder_7_seg decoder(SW[1:0], HEX0[6:0]);

endmodule

module decoder_7_seg(
	input [1:0] c,
	output [6:0] h);

	assign {h[6], h[4], h[3]} = {3{ c[1] }};
	assign {h[5], h[0]} = {2{ (~c[0]) | c[1] }};
	assign {h[2], h[1]} = {2{ c[0] }};

endmodule
