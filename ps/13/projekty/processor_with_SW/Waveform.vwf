/*<simulation_settings>
<ftestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=verilog --write_settings_files=off processor_with_SW -c processor_with_SW --vector_source="D:/Storage/temp/semestr_6/sw/13/projekty/processor_with_SW/Waveform.vwf" --testbench_file="D:/Storage/temp/semestr_6/sw/13/projekty/processor_with_SW/simulation/qsim/Waveform.vwf.vt"</ftestbench_cmd>
<ttestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=verilog --write_settings_files=off processor_with_hex -c processor_with_hex --vector_source="D:/Storage/temp/semestr_6/sw/13/projekty/processor_with_hex/Waveform.vwf" --testbench_file="D:/Storage/temp/semestr_6/sw/13/projekty/processor_with_hex/simulation/qsim/Waveform.vwf.vt"</ttestbench_cmd>
<fnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=on --flatten_buses=off --tool=modelsim_oem --format=verilog --output_directory="D:/Storage/temp/semestr_6/sw/13/projekty/processor_with_SW/simulation/qsim/" processor_with_SW -c processor_with_SW</fnetlist_cmd>
<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=verilog --output_directory="D:/Storage/temp/semestr_6/sw/13/projekty/processor_with_hex/simulation/qsim/" processor_with_hex -c processor_with_hex</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
vlib work
vlog -work work processor_with_SW.vo
vlog -work work Waveform.vwf.vt
vsim -novopt -c -t 1ps -L cyclonev_ver -L altera_ver -L altera_mf_ver -L 220model_ver -L sgate_ver -L altera_lnsim_ver work.processor_with_SW_vlg_vec_tst
vcd file -direction processor_with_SW.msim.vcd
vcd add -internal processor_with_SW_vlg_vec_tst/*
vcd add -internal processor_with_SW_vlg_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f


</modelsim_script>
<modelsim_script_timing>onerror {exit -code 1}
vlib work
vlog -work work processor_with_hex.vo
vlog -work work Waveform.vwf.vt
vsim -novopt -c -t 1ps -L cyclonev_ver -L altera_ver -L altera_mf_ver -L 220model_ver -L sgate_ver -L altera_lnsim_ver work.processor_with_hex_vlg_vec_tst
vcd file -direction processor_with_hex.msim.vcd
vcd add -internal processor_with_hex_vlg_vec_tst/*
vcd add -internal processor_with_hex_vlg_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f


</modelsim_script_timing>
<hdl_lang>verilog</hdl_lang>
</simulation_settings>*/
