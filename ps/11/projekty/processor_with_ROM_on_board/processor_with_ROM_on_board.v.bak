module processor_with_ROM(
	input MClock, Resetn, PClock, Run,
	output reg Done,
	output reg [8:0] BusWires);

	wire [4:0] read_addr;
	counter_N_bits #(5) address_counter(MClock, Resetn, read_addr);
	wire [8:0] DIN /* synthesis keep */;
	rom32x9 rom(read_addr, MClock, DIN);

	// stany FSM
	localparam [1:0] T0 = 2'b00, T1 = 2'b01, T2 = 2'b10, T3 = 2'b11;
	// kody instrukcji
	localparam [1:0] mv = 2'b00, mvi = 2'b01, add = 2'b10, sub = 2'b11;
	wire [0:7] Xreg, Yreg;
	wire [2:0] I;
	wire [9:1] IR;
	wire [8:0] A, G;
	wire [8:0] R0, R1, R2, R3, R4, R5, R6, R7;
	reg G_in, G_out, DIN_out, AddSub, IR_in, A_in;
	wire [8:0] Sum;
	reg [1:0] Tstep_Q;
	reg [1:0] Tstep_D;
	reg [0:7] R_in, R_out;

	assign I = IR[9:7];
	dec3to8 decX(IR[6:4], 1'b1, Xreg);
	dec3to8 decY(IR[3:1], 1'b1, Yreg);

	// sterowanie przejściami między stanami FSM
	always @ (Tstep_Q, Run, Done)
		case (Tstep_Q)
			T0:
				if (~Run) Tstep_D = T0;
				else Tstep_D = T1;
			T1:
				if (Done) Tstep_D = T0;
				else Tstep_D = T2;
			T2:
				Tstep_D = T3;
			T3:
				Tstep_D = T0;
		endcase

	// sterowanie wyjściami FSM
	always @(Tstep_Q, I, Xreg, Yreg) begin
		Done = 1'b0;
		G_in = 1'b0;
		G_out = 1'b0;
		A_in = 1'b0;
		AddSub = 1'b0;
		DIN_out = 1'b0;
		R_in = 8'b0000_0000;
		R_out = 8'b0000_0000;
		IR_in = 1'b0;
		case (Tstep_Q)
			T0: // zapamiętujemy DIN w IR w takcie 0
				IR_in = 1'b1;
			T1: // wyjścia z FSM w takcie 1
				case (I)
					mv: begin
						R_out = Yreg;
						R_in = Xreg;
						Done = 1'b1;
					end
					mvi: begin
						DIN_out = 1'b1;
						R_in = Xreg;
						Done = 1'b1;
					end
					add, sub: begin
						R_out = Xreg;
						A_in = 1'b1;
					end
				endcase
			T2: // wyjścia z FSM w takcie 2
				case (I)
					// mv, mvi: ; // nie występują
					add: begin
						R_out = Yreg;
						G_in = 1'b1;
					end
					sub: begin
						R_out = Yreg;
						G_in = 1'b1;
						AddSub = 1'b1;
					end
				endcase
			T3: // wyjścia z FSM w takcie 3
				case (I)
					// mv, mvi: ; // nie występują
					add, sub: begin
						G_out = 1'b1;
						R_in = Xreg;
						Done = 1'b1;
					end
				endcase
		endcase
	end

	// sterowanie przerzutnikami FSM
	always @(posedge PClock, negedge Resetn)
		if (~Resetn) Tstep_Q <= T0;
		else Tstep_Q <= Tstep_D;

	// rejestry
	regn #(9) reg_0(BusWires, R_in[0], PClock, R0);
	regn #(9) reg_1(BusWires, R_in[1], PClock, R1);
	regn #(9) reg_2(BusWires, R_in[2], PClock, R2);
	regn #(9) reg_3(BusWires, R_in[3], PClock, R3);
	regn #(9) reg_4(BusWires, R_in[4], PClock, R4);
	regn #(9) reg_5(BusWires, R_in[5], PClock, R5);
	regn #(9) reg_6(BusWires, R_in[6], PClock, R6);
	regn #(9) reg_7(BusWires, R_in[7], PClock, R7);
	regn #(9) reg_A(BusWires, A_in, PClock, A);
	regn #(9) reg_G(Sum, G_in, PClock, G);
	regn #(9) reg_IR(DIN[8:0], IR_in, PClock, IR);

	ripple_carry_adder_subtractor #(9) alu(A, BusWires, AddSub, Sum);

	wire [0:9] mux_s;
	assign mux_s = {DIN_out, R_out, G_out};
	always @ (*)
		case (mux_s)
			default: BusWires = DIN;
			10'b0100000000: BusWires = R0; 
			10'b0010000000: BusWires = R1;
			10'b0001000000: BusWires = R2;
			10'b0000100000: BusWires = R3;
			10'b0000010000: BusWires = R4; 
			10'b0000001000: BusWires = R5;
			10'b0000000100: BusWires = R6;
			10'b0000000010: BusWires = R7;
			10'b0000000001: BusWires = G;
		endcase

endmodule

module regn #(parameter N = 9)(
	input [N-1:0] R,
	input Rin, Clock,
	output reg [N-1:0] Q);

	always @ (posedge Clock)
		if (Rin) Q <= R;
		else Q <= Q;

endmodule

module dec3to8(
	input [2:0] W,
	input En,
	output reg [0:7] Y);

	always @ (W, En)
		if (En == 1)
			case (W)
				3'b000: Y = 8'b10000000;
				3'b001: Y = 8'b01000000;
				3'b010: Y = 8'b00100000;
				3'b011: Y = 8'b00010000;
				3'b100: Y = 8'b00001000;
				3'b101: Y = 8'b00000100;
				3'b110: Y = 8'b00000010;
				3'b111: Y = 8'b00000001;
			endcase
		else
			Y = 8'b00000000;

endmodule

module ripple_carry_adder_subtractor
	#(parameter N = 4)(
	input [N-1:0] A, B,
	input sub,
	output [N-1:0] S);
	// output cout,
	// output overflow);

	wire [N-2:0] c;
	// assign overflow = c[N-2] ^ cout;
	generate
		genvar i;
		for (i = 0; i < N; i = i + 1)
		begin: ad
			case (i)
				0: full_adder fa(A[i], sub ^ B[i], sub, S[i], c[i]);
				N-1: full_adder fa(A[i], sub ^ B[i], c[i-1], S[i],/*cout*/);
				default: full_adder fa(A[i], sub ^ B[i], c[i-1], S[i], c[i]);
			endcase
		end
	endgenerate

endmodule

module full_adder(
	input a, b, cin,
	output s, cout);

	assign s = cin ^ (a ^ b);
	assign cout = a & b | (a ^ b) & cin;

endmodule

module counter_N_bits
  #(parameter N = 4)(
  input clock, areset,
  output reg [N-1:0] state);

  initial state = {N{1'b0}};
  always @ (posedge clock, negedge areset)
		if (~areset) state <= {N{1'b0}};
		else state <= state + 1'b1;

endmodule
