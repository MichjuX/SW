module binary_bcd_4_bits(
    input [3:0] v,
    output [3:0] di, d0);

    wire v_greater_than_9 = (v > 4'd9);
    wire [3:0] v_minus_10 = v - 4'd10;
    wire [3:0] lower_bcd_digit;
    mux_2_1_4_bits_mux(v, v_minus_10, v_greater_than_9, lower_bcd_digit);
    assign di = {3'b000, v_greater_than_9};
    assign d0 = lower_bcd_digit;

endmodule