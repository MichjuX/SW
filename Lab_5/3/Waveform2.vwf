		LEVEL 0 FOR 11.189;
		LEVEL 1 FOR 3.216;
		LEVEL 0 FOR 16.817;
		LEVEL 1 FOR 3.685;
		LEVEL 0 FOR 8.226;
	}
}

TRANSITION_LIST("aclr")
