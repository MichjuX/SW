		REPEAT = 1;
		LEVEL 0 FOR 3.551;
		LEVEL 1 FOR 1.876;
		LEVEL 0 FOR 8.174;
		LEVEL 1 FOR 2.948;
		LEVEL 0 FOR 6.633;
		LEVEL 1 FOR 28.207;
		LEVEL 0 FOR 18.611;
	}
}

TRANSITION_LIST("clk")
{
	NODE
	{
		REPEAT = 1;
		NODE
		{
			REPEAT = 7;
			LEVEL 0 FOR 5.0;
			LEVEL 1 FOR 5.0;
		}
	}
}

TRANSITION_LIST("nQ")
{
	NODE
	{
		REPEAT = 1;
		LEVEL X FOR 70.0;
	}
}

