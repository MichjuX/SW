module adder_A_B_8_bits_board(
    input [7:0] SW,
    input [1:0] KEY,
    output [6:0] HEX7, HEX6, HEX5, HEX4,
    output [6:0] HEX3, HEX2, HEX1, HEX0,
    output [9:0] LEDR
);

decoder_hex_16 A0(HEX7, SW[7:4]);
decoder_hex_16 A1(HEX6, SW[3:0]);

wire [7:0] A_B = SW[7:0];
assign LEDR[9:2] = 0;
assign LEDR[1:0] = SW[1:0];

decoder_hex_16 S0(HEX1, s[7:4]);
decoder_hex_16 S1(HEX0, s[3:0]);

wire [7:0] A, s;
wire cout;

adder_A_B_8_bits adder(SW, ~KEY[0], ~KEY[1], A, cout, s);

endmodule
