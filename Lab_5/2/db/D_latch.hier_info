nQa <= D_latch:latch.port3
Qb <= FDD_posedge:FDD_p.port2
nQb <= FDD_posedge:FDD_p.port3
Qc <= FDD_negedge:FDD_n.port2
nQc <= FDD_negedge:FDD_n.port3


|latch_FDDP_FDDN|D_latch:latch
